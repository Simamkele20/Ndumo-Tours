{
  "name": "ndumo-tours-backend",
  "version": "1.0.0",
  "description": "Ndumo Tours API - Node.js/Express backend with MySQL/cPanel",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "dev:frontend": "cd ../ndumo-tours-angular && npm run start",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ndumo",
    "tours",
    "api",
    "express",
    "mysql",
    "cpanel"
  ],
  "author": "Ndumo Tours",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.5",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.9.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2"
  }
}
