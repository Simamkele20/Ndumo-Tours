{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "NODE_ENV": {
      "required": true
    },
    "DATABASE_HOST": {
      "required": true
    },
    "DATABASE_PORT": {
      "required": true
    },
    "DATABASE_USER": {
      "required": true
    },
    "DATABASE_PASSWORD": {
      "required": true
    },
    "DATABASE_NAME": {
      "required": true
    },
    "JWT_SECRET": {
      "required": true
    }
  }
}
